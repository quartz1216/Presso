<Window x:Class="Presso.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presso" Height="180" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="presso_icon.ico"
        ResizeMode="NoResize"
        Topmost="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="FileNameText" FontWeight="SemiBold" FontSize="14"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,4,0,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Row="2" x:Name="ProgressBarCtl" Margin="0,12,0,0"
                     Height="18" Maximum="100"/>
        <Button Grid.Row="3" x:Name="ActionButton" Content="Cancel"
                Click="Action_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
