<Window x:Class="Presso.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presso Settings" Height="430" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="presso_icon.ico"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Target size -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Target Size (MB)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" x:Name="TargetSizeLabel"
                           Text="10 MB" Width="60" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Slider x:Name="TargetSizeSlider" Minimum="1" Maximum="500" Value="10"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="TargetSizeSlider_Changed"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="10" Click="Preset_Click" Tag="10" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="25" Click="Preset_Click" Tag="25" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="50" Click="Preset_Click" Tag="50" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="100" Click="Preset_Click" Tag="100" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="500" Click="Preset_Click" Tag="500" Padding="10,4"/>
            </StackPanel>
        </StackPanel>

        <!-- HEVC -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <CheckBox x:Name="UseHevcCheck" Content="Use HEVC (H.265)" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="22,4,0,0"
                       Text="Higher compression. If off, uses H.264 (Maximum compatibility)"/>
        </StackPanel>

        <!-- Output -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Output Location (GUI)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <RadioButton x:Name="OutSourceDir" Content="Same as source folder" GroupName="OutMode" Margin="0,0,0,4"/>
            <RadioButton x:Name="OutFixedDir" Content="Specific folder" GroupName="OutMode"/>
            <DockPanel Margin="22,4,0,0" IsEnabled="{Binding IsChecked, ElementName=OutFixedDir}">
                <Button DockPanel.Dock="Right" Content="Browse..." Width="64"
                        Click="Browse_Click" Margin="6,0,0,0"/>
                <TextBox x:Name="FixedDirBox" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="0,8,0,0"
                       Text="* If launched from right-click menu, output is always in the source folder."/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Licenses" Click="Licenses_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
